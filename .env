# =========================================================
# KALRO Mkulima — Backend Environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# =========================================================

# ───────────────────────────── Django ─────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-me-with-50-plus-random-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate a strong key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ──────────────────────────── Database ────────────────────────────
# Postgres 15+ with PostGIS extension recommended for county boundaries.
# DATABASE_URL=postgres://kalro:kalro@localhost:5432/kalro

# Postgres
POSTGRES_DB=kalro_mkulima_v2_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Pool tuning (optional — defaults are sensible for local dev)
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=30
DB_POOL_MAX_IDLE=300


# Optional direct components if your hosting doesn't use a single URL:
# POSTGRES_DB=kalro
# POSTGRES_USER=kalro
# POSTGRES_PASSWORD=kalro
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ───────────────────────────── Redis ──────────────────────────────
# Used for Celery broker/result and Django cache.
REDIS_URL=redis://localhost:6379/0

# Optional separate caches:
# CACHE_URL=redis://localhost:6379/1

# ─────────────────────────── CORS / CSRF ──────────────────────────
# The React frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ──────────────────────── JWT (auth tokens) ───────────────────────
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=30

# ─────────────────────── Media / file storage ─────────────────────
# Local dev uses FileSystemStorage; prod uses S3-compatible object storage.
USE_S3=False

# AWS / S3 (or MinIO, Cloudflare R2, DigitalOcean Spaces, Backblaze B2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=kalro-mkulima-media
AWS_S3_REGION_NAME=eu-west-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=3600

# Cloudflare R2 example:
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.kalro.org

# ──────────────────────── Video / streaming ───────────────────────
# Where HLS/DASH manifests live. Can be the same bucket or a CDN.
STREAM_BASE_URL=https://cdn.kalro.org/hls/
STREAM_SIGNING_KEY=
STREAM_SIGNING_TTL_SECONDS=600

# ────────────────────────── Email (SMTP) ──────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@kalro.org
SERVER_EMAIL=noreply@kalro.org

# For production with a real provider (SendGrid, SES, Mailgun):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────── SMS (Africa's Talking) ───────────────
# Used for OTP, field-day reminders, badge alerts.
SMS_PROVIDER=africastalking
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=KALRO

# ──────────────────────────── Push (FCM) ───────────────────────────
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# ────────────────────────── Celery / tasks ────────────────────────
CELERY_TASK_ALWAYS_EAGER=False
# CELERY_TASK_ALWAYS_EAGER=True
CELERY_TIMEZONE=Africa/Nairobi
CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=cache+memory://


# ────────────────────────── Badge configuration ───────────────────
KALRO_BADGE_ID_PREFIX=KALRO-B
KALRO_BADGE_EXPIRY_DAYS=0
KALRO_BADGE_VERIFY_BASE_URL=https://mkulima.kalro.org/badges/verify

# ──────────────────────── Offline media limits ────────────────────
KALRO_MAX_OFFLINE_DOWNLOAD_MB=200
KALRO_DEFAULT_HLS_VARIANT_HEIGHT=480

# ──────────────────────────── Security ────────────────────────────
# Used by the deployment layer to sign short-lived download URLs.
MEDIA_SIGNING_KEY=replace-me-with-32-plus-random-characters

# Google reCAPTCHA on the registration form (optional)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ──────────────────────── Third-party: KALRO tools ───────────────
# Base URLs for the digital tools surfaced on lesson pages. These are
# read by scripts/seed_courses.py so the React frontend always links
# to the correct targets.
KAMIS_BASE_URL=https://kamis.kilimo.go.ke/
KALRO_SELECTOR_URL=https://selector.kalro.org/
KAOP_BASE_URL=https://kaop.co.ke/
KALRO_KHUB_URL=https://kalro.org/kalro-k-hub/

# ──────────────────────── Monitoring (optional) ──────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ──────────────────────── Analytics ───────────────────────────────
# Matomo / PostHog / GA4, whichever the team uses.
ANALYTICS_BACKEND=
ANALYTICS_SITE_ID=
ANALYTICS_HOST=

# ──────────────────────── Feature flags ───────────────────────────
FEATURE_OFFLINE_MEDIA=True
FEATURE_BADGE_VERIFY=True
FEATURE_FIELD_DAYS=True
FEATURE_DASHBOARD=True
FEATURE_COUNTY_DASHBOARDS=False

# ──────────────────────── Admin bootstrap ────────────────────────
# Used by `python manage.py createsuperuser` in CI or first-run scripts.
DJANGO_SUPERUSER_EMAIL=admin@kalro.org
DJANGO_SUPERUSER_PHONE=+254700000000
DJANGO_SUPERUSER_PASSWORD=change-me-immediately